opam-version: "2.0"
synopsis:
  "A chat bridge of your own: Twitch and YouTube chat on remux's wire"
depends: [
  "dune" {>= "3.7"}
  "ocaml" {>= "5.1"}
  "eio"
  "eio_main"
  "tls"
  "tls-eio"
  "ca-certs"
  "x509"
  "cohttp-eio"
  "http"
  "uri"
  "domain-name"
  "ipaddr"
  "mirage-crypto-rng"
  "yojson"
  "digestif"
  "base64"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
